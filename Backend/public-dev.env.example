# Development-only public HiveMQ profile. Copy to .env.public-dev.
# This file is layered over Backend/.env; do not add database/auth credentials.
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_CERT=
MQTT_CA_CERT_PATH=
MQTT_DEVICE_SCOPED_TOPICS=true
MQTT_TOPIC_NAMESPACE=aquasense-dev
MQTT_ACTUATOR_COMMANDS_ENABLED=false
PORT=5002
