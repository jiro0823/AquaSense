# Server Configuration
NODE_ENV=development
PORT=5001
HOST=localhost

# API Configuration
API_VERSION=v1

# Logging
LOG_LEVEL=debug

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=AquaSense
DB_USER=postgres
DB_PASSWORD=replace-with-local-password
DB_DIALECT=postgres

# JWT / Cookie Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRY=24h
AUTH_COOKIE_NAME=aquasense_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_MAX_AGE_MS=86400000

# MQTT Configuration (ESP32 -> Backend)
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC_READINGS=water/esp32/readings
MQTT_TOPIC_SENSOR_WILDCARD=aquasense/+
MQTT_DEFAULT_DO=0

# SMS / Farm Alerts
UNISMS_API_SECRET_KEY=replace-with-unisms-secret
UNISMS_SENDER_ID=AquaSense
FARMER_NAME=Farmer
FARMER_PHONE=+630000000000
TANK_NAME=MainTank

# Device API keys, comma-separated as device-id:key
DEVICE_KEYS=tank-001:replace-with-device-key
