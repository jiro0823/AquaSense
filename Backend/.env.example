# Server Configuration
NODE_ENV=development
PORT=5001
HOST=localhost

# API Configuration
API_VERSION=v1

# Logging
LOG_LEVEL=debug

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=AquaSense
DB_USER=postgres
DB_PASSWORD=<local-database-password>
DB_DIALECT=postgres

# JWT / Cookie Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<minimum-32-character-secret>
JWT_EXPIRY=24h
AUTH_COOKIE_NAME=aquasense_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_MAX_AGE_MS=86400000

# MQTT Configuration (ESP32 -> Backend)
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC_READINGS=water/esp32/readings
MQTT_TOPIC_SENSOR_WILDCARD=aquasense/+
MQTT_TOPIC_COMMANDS=water/commands/#
MQTT_TOPIC_STATUS=water/esp32/status
# Set MQTT_USERNAME and MQTT_PASSWORD only when the broker requires authentication.
MQTT_USERNAME=
MQTT_PASSWORD=
# Oxygen must be supplied by a sensor; omitted oxygen is marked unmeasured.

# SMS / Farm Alerts (optional integration; API starts without these values)
UNISMS_API_SECRET_KEY=<your-unisms-secret>
# Required to send SMS: use the exact sender ID assigned/approved by UniSMS.
UNISMS_SENDER_ID=<your-approved-sender-id>
FARMER_NAME=Farmer
# Leave blank until you enter the real farmer mobile in +639XXXXXXXXX format.
FARMER_PHONE=
FARM_NAME=AquaSense Farm
TANK_NAME=MainTank

# Feeding
FEEDER_DEVICE_ID=esp32-feeder-1
FEEDING_TIMEZONE=Asia/Manila

# Device API keys, comma-separated as device-id:key
DEVICE_KEYS=tank-001:replace-with-device-key

# Development-only device ingestion bypass. Keep false unless deliberately testing without keys.
ALLOW_UNAUTHENTICATED_DEVICES=false
