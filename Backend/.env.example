# Server Configuration
NODE_ENV=development
PORT=5000
HOST=localhost

# API Configuration
API_VERSION=v1

# Logging
LOG_LEVEL=debug

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# MQTT Configuration (ESP32 -> Backend)
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC_READINGS=water/esp32/readings
MQTT_TOPIC_SENSOR_WILDCARD=aquasense/+
MQTT_DEFAULT_DO=0
