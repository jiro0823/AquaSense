# Server Configuration
NODE_ENV=development
PORT=5001
HOST=localhost

# API Configuration
API_VERSION=v1

# Logging
LOG_LEVEL=debug

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=AquaSense
DB_USER=postgres
DB_PASSWORD=1234567890
DB_DIALECT=postgres

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production_12345
JWT_EXPIRY=24h

# Database Pool Settings (optional)
DB_POOL_MAX=5
DB_POOL_MIN=0

# MQTT Configuration (ESP32 -> Backend)
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC_READINGS=water/esp32/readings
MQTT_TOPIC_SENSOR_WILDCARD=aquasense/+
MQTT_DEFAULT_DO=0
